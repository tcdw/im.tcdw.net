---
import '../styles/global.css';
import SectionHeading from '../components/SectionHeading.astro';
import { about, contacts, identities, misc, now, profile, projects, stack, topics } from '../data/profile';

/** 以「待补充」开头的文字按占位样式渲染 */
const isPlaceholder = (text: string) => text.startsWith('待补充');
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="5 分钟了解 tcdw：我是谁、最近在做什么、技术方向，以及适合和我聊的话题。"
   />
    <title>5 分钟了解 tcdw</title>
  </head>

  <body class="bg-gray-100/70 text-gray-700 sheet:p-10">
    <div
      class="sheet mx-auto flex w-full max-w-(--sheet-max) flex-col rounded-2xl bg-white shadow-2xl sheet:min-h-(--sheet-h)"
    >
      <!-- 报头 -->
      <header
        class="flex flex-col gap-3 border-b border-gray-200 px-5 pt-7 pb-5 sheet:flex-row sheet:items-end sheet:justify-between sheet:gap-10 sheet:ps-6 sheet:pe-6 sheet:pt-5 sheet:pb-4"
      >
        <div class="flex-0">
          <p class="text-sm text-primary-600">
            {profile.kicker}
          </p>
          <h1 class="mt-2 flex items-baseline gap-2.5 sheet:mt-1.5">
            <span
              class="text-(length:--fs-display) leading-none tracking-tight text-gray-900"
              >{profile.name}</span
            >
            <span class="text-(length:--fs-sep) leading-none text-gray-300"
              >／</span
            >
            <span
              class="text-(length:--fs-alias) leading-none font-medium text-gray-600"
              >{profile.alias}</span
            >
          </h1>
        </div>
        <div class="flex-1 space-y-1">
          <p
            class:list={[
              "text-(length:--fs-lede) leading-relaxed text-end",
              isPlaceholder(profile.tagline) ? "ph" : "text-gray-600",
            ]}
          >
            {profile.tagline}
          </p>
          <p class="text-(length:--fs-motto) text-accent-700/80 text-end">
            {profile.motto}{" "}
            <span class="text-gray-400">- GitHub bio</span>
          </p>
        </div>
      </header>

      <!-- 主体 -->
      <div
        class="flex flex-1 flex-col sheet:grid sheet:grid-cols-[var(--col-side)_1fr] sheet:grid-rows-[auto_1fr]"
      >
        <!-- 侧栏 · 上半：头像与状态 -->
        <aside
          class="border-b border-gray-200 px-5 py-6 sheet:col-start-1 sheet:row-start-1 sheet:border-b-0 sheet:border-r sheet:px-6 sheet:pt-(--pad-y) sheet:pb-0"
        >
          {
            profile.avatar ? (
              <img
                src={profile.avatar}
                alt={profile.name}
                class="aspect-square w-24 rounded-xl object-cover sheet:w-26"
             />
            ) : (
              <div class="grid aspect-square w-24 place-items-center rounded-sm border border-dashed border-primary-300 bg-primary-100/50 text-(length:--fs-label) tracking-[0.2em] text-primary-700/70 sheet:w-26">
                Avatar
              </div>
            )
          }

          <dl class="mt-5 space-y-2.5 sheet:space-y-3">
            {
              now.map((row) => (
                <div>
                  <dt class="text-(length:--fs-label) tracking-[0.16em] text-slate-400 uppercase">
                    {row.label}
                  </dt>
                  <dd
                    class:list={[
                      "mt-0.5 text-(length:--fs-side) leading-snug",
                      isPlaceholder(row.value) ? "ph" : "text-gray-700",
                    ]}
                  >
                    {row.value}
                  </dd>
                </div>
              ))
            }
          </dl>
        </aside>

        <!-- 主内容 -->
        <main
          class="flex flex-col gap-6 px-5 py-6 sheet:col-start-2 sheet:row-span-2 sheet:row-start-1 sheet:justify-between sheet:gap-6 sheet:px-8 sheet:py-8 sheet:py-(--pad-y)"
        >
          <section>
            <SectionHeading title="我是谁" />
            <div class="mt-2.5 space-y-1.5">
              {
                about.map((line) => (
                  <p
                    class:list={[
                      "text-(length:--fs-body) leading-relaxed",
                      isPlaceholder(line) ? "ph" : "text-gray-700",
                    ]}
                  >
                    {line}
                  </p>
                ))
              }
            </div>
          </section>

          <section>
            <SectionHeading title="最近在做什么" />
            <div class="mt-4 grid gap-4 sheet:grid-cols-2 sheet:gap-6">
              {
                projects.map((project) => (
                  <article class="border-l-2 border-primary-200 pl-4">
                    <div class="flex items-baseline gap-3">
                      <h3 class="text-(length:--fs-item-title) font-semibold text-gray-900">
                        {project.title}
                      </h3>
                      <span class="text-(length:--fs-kind) tracking-[0.12em] text-accent-700">
                        {project.kind}
                      </span>
                    </div>
                    <p
                      class:list={[
                        "mt-1 text-(length:--fs-item) leading-relaxed",
                        isPlaceholder(project.summary)
                          ? "ph"
                          : "text-gray-700",
                      ]}
                    >
                      {project.summary}
                    </p>
                    <p
                      class:list={[
                        "mt-2 text-(length:--fs-detail) leading-relaxed",
                        isPlaceholder(project.detail) ? "ph" : "text-gray-500",
                      ]}
                    >
                      {project.detail}
                    </p>
                  </article>
                ))
              }
            </div>
          </section>

          <div
            class="flex flex-col gap-6 sheet:grid sheet:grid-cols-[1fr_1fr] sheet:gap-0"
          >
            <section>
              <SectionHeading title="技术方向" />
              <div class="mt-4 space-y-2.5 sheet:space-y-5">
                {
                  stack.map((group) => (
                    <div>
                      <p class="text-(length:--fs-label) tracking-[0.16em] text-gray-400">
                        {group.group}
                      </p>
                      <ul class="mt-1.5 flex flex-wrap gap-1.5 sheet:gap-1">
                        {group.items.map((item) => (
                          <li class="rounded-md border border-primary-200 bg-primary-50/70 px-2 py-0.5 text-(length:--fs-tag) text-gray-800">
                            {item}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </section>
            <section>
              <SectionHeading title="适合和我聊" />
              <ol class="mt-4 space-y-1.5 sheet:space-y-3.5">
                {
                  topics.map((topic, index) => (
                    <li class="flex gap-2 text-(length:--fs-item) leading-snug text-gray-700">
                      <span class="shrink-0 pt-px font-mono text-(length:--fs-num) text-primary-500">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                      <span>{topic}</span>
                    </li>
                  ))
                }
              </ol>
            </section>
          </div>
        </main>

        <!-- 侧栏 · 下半：联系方式与网络身份 -->
        <aside
          class="border-t border-gray-200 px-5 py-6 sheet:col-start-1 sheet:row-start-2 sheet:flex sheet:flex-col sheet:border-t-0 sheet:border-r sheet:border-gray-200 sheet:px-6 sheet:pt-(--gap-side) sheet:pb-(--pad-y)"
        >
          <div
            class="space-y-5 sheet:flex sheet:h-full sheet:flex-col sheet:justify-between sheet:gap-(--gap-side) sheet:space-y-0"
          >
            <div>
              <SectionHeading title="联系方式" />
              <dl class="mt-2.5 space-y-1.5">
                {
                  contacts.map((row) => (
                    <div class="flex items-baseline gap-2">
                      <dt class="w-(--w-label) shrink-0 text-(length:--fs-label) tracking-[0.16em] text-gray-400">
                        {row.label}
                      </dt>
                      <dd
                        class:list={[
                          "text-(length:--fs-side) leading-snug",
                          isPlaceholder(row.value) ? "ph" : "text-gray-700",
                        ]}
                      >
                        {row.value}
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </div>

            <div>
              <SectionHeading title="互联网身份" />
              <dl class="mt-2.5 space-y-1.5">
                {
                  identities.map((row) => (
                    <div class="flex items-baseline gap-2">
                      <dt class="w-(--w-label) shrink-0 text-(length:--fs-label) tracking-[0.16em] text-gray-400">
                        {row.label}
                      </dt>
                      <dd class="text-(length:--fs-side) leading-snug">
                        <a
                          href={row.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-primary-800 underline decoration-primary-300 underline-offset-2 transition-colors hover:text-primary-600 hover:decoration-primary-500"
                        >
                          {row.value}
                        </a>
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </div>

            <div>
              <SectionHeading title="其他" />
              <dl class="mt-2.5 space-y-2">
                {
                  misc.map((row) => (
                    <div>
                      <dt class="text-(length:--fs-label) tracking-[0.16em] text-gray-400">
                        {row.label}
                      </dt>
                      <dd
                        class:list={[
                          "mt-0.5 text-(length:--fs-side) leading-snug",
                          isPlaceholder(row.value) ? "ph" : "text-gray-700",
                        ]}
                      >
                        {row.value}
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>
        </aside>
      </div>

      <!-- 页脚 -->
      <footer
        class="flex items-center justify-between gap-4 border-t border-gray-200 px-5 py-4 text-(length:--fs-micro) text-gray-400 sheet:px-6 sheet:py-2.5"
      >
        <p class="tracking-[0.14em]">
          &copy; {new Date().getFullYear()} tcdw | Updated {profile.updatedAt}
        </p>
        <!--<div class="flex items-center gap-4">-->
        <!--  <button-->
        <!--    type="button"-->
        <!--    onclick="window.print()"-->
        <!--    class="cursor-pointer rounded-xs border border-gray-200 px-2 py-0.5 tracking-[0.14em] text-gray-500 transition-colors hover:border-primary-300 hover:text-primary-700 print:hidden"-->
        <!--  >-->
        <!--    打印 / PDF-->
        <!--  </button>-->
        <!--</div>-->
      </footer>
    </div>
  </body>
</html>
