---
import '../styles/global.css';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import avatar from '../assets/avatar.png';
import corner from '../assets/corner.jpg';
import SectionHeading from '../components/SectionHeading.astro';
import { about, contacts, identities, notes, now, profile, projects, stack } from '../data/profile';

/** 以「待补充」开头的文字按占位样式渲染 */
const isPlaceholder = (text: string) => text.startsWith('待补充');

/** 协议头和末尾斜杠在纸上是噪音，打印时只留地址本体 */
const printableUrl = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="generator" content={Astro.generator}>
    <meta name="description" content="5 分钟了解 tcdw：我是谁、最近在做什么，以及主要的技术方向。">
    <title>5 分钟了解 tcdw</title>
  </head>

  <body class="bg-secondary-100/70 text-secondary-700 sheet:p-10">
    <div
      class="sheet relative isolate mx-auto flex w-full max-w-(--sheet-max) flex-col overflow-hidden sheet:rounded-2xl bg-white sheet:shadow-2xl sheet:min-h-(--sheet-h)"
    >
      <!-- 右下角的装饰画：isolate + -z-10 让它压在白底之上、正文之下 -->
      <Image
        src={corner}
        alt=""
        aria-hidden="true"
        width={480}
        height={640}
        densities={[1, 2]}
        class="pointer-events-none absolute right-4 bottom-12 -z-10 w-60 opacity-8 sheet:w-120"
      />
      <!-- 报头 -->
      <header
        class="flex flex-col gap-3 sheet:border-b sheet:border-secondary-200 px-5 pt-7 sheet:pb-5 sheet:flex-row sheet:items-end sheet:justify-between sheet:gap-10 sheet:ps-6 sheet:pe-6 sheet:pt-5 sheet:pb-4"
      >
        <div class="flex-0 flex">
          <div class="flex-1">
            <p class="text-sm text-primary-600">
              {profile.kicker}
            </p>
            <h1 class="mt-2 flex items-baseline gap-2.5 sheet:mt-1.5">
              <span class="text-(length:--fs-display) leading-none tracking-tight text-secondary-900"
                >{profile.name}</span
              >
              <span class="text-(length:--fs-sep) leading-none text-secondary-300">／</span>
              <span class="text-(length:--fs-alias) leading-none font-medium text-secondary-600">{profile.alias}</span>
            </h1>
          </div>
          <Image
            src={avatar}
            alt={profile.name}
            width={64}
            height={64}
            densities={[1, 2]}
            class="flex-0 sheet:hidden aspect-square w-16 rounded-full object-cover"
          />
        </div>
        <div class="flex-1 space-y-1">
          <p
            class:list={[
              "text-(length:--fs-lede) leading-relaxed sheet:text-end",
              isPlaceholder(profile.tagline) ? "ph" : "text-secondary-600",
            ]}
          >
            {profile.tagline}
          </p>
          <p class="text-(length:--fs-motto) text-primary-700/80 sheet:text-end">
            {profile.motto}{" "}
            <span class="text-secondary-400">- GitHub bio</span>
          </p>
        </div>
      </header>

      <!-- 主体 -->
      <div class="flex flex-1 flex-col sheet:grid sheet:grid-cols-[var(--col-side)_1fr] sheet:grid-rows-[auto_1fr]">
        <!-- 侧栏 · 上半：头像与状态 -->
        <aside
          class="border-b border-secondary-200 px-5 py-6 sheet:col-start-1 sheet:row-start-1 sheet:border-b-0 sheet:border-r sheet:px-6 sheet:pt-(--pad-y) sheet:pb-0"
        >
          <Image
            src={avatar}
            alt={profile.name}
            width={104}
            height={104}
            densities={[1, 2]}
            class="hidden sheet:block aspect-square w-24 rounded-xl object-cover sheet:w-26"
          />
          <dl class="sheet:mt-5 space-y-2.5 sheet:space-y-3">
            {now.map((row) => (
                <div>
                  <dt class="text-(length:--fs-label) tracking-[0.16em] text-secondary-400 uppercase">
                    {row.label}
                  </dt>
                  <dd
                    class:list={[
                      "mt-0.5 text-(length:--fs-side) leading-snug",
                      isPlaceholder(row.value) ? "ph" : "text-secondary-700",
                    ]}
                  >
                    {row.value}
                  </dd>
                </div>
              ))}
          </dl>
        </aside>

        <!-- 主内容 -->
        <main
          class="flex flex-col gap-6 px-5 py-6 sheet:col-start-2 sheet:row-span-2 sheet:row-start-1 sheet:justify-between sheet:gap-6 sheet:px-8 sheet:py-8 sheet:py-(--pad-y)"
        >
          <section>
            <SectionHeading title="我是谁" />
            <div class="mt-2.5 space-y-1.5">
              {about.map((line) => (
                  <p
                    class:list={[
                      "text-(length:--fs-body) leading-relaxed",
                      isPlaceholder(line) ? "ph" : "text-secondary-700",
                    ]}
                  >
                    {line}
                  </p>
                ))}
            </div>
          </section>

          <section>
            <SectionHeading title="最近在做什么" />
            <div class="mt-4 grid gap-4 sheet:grid-cols-2 sheet:gap-6">
              {projects.map((project) => (
                  <article class="border-l-2 border-primary-200 pl-4">
                    <div class="flex items-baseline gap-3">
                      <h3 class="text-(length:--fs-item-title) font-semibold">
                        {project.url ? (
                          <a
                            href={project.url}
                            class="text-secondary-900 hover:text-primary-500 focus:text-primary-600 transition-colors duration-200"
                          >
                            {project.title}
                          </a>
                        ) : (
                          <span class="text-secondary-900">{project.title}</span>
                        )}
                      </h3>
                      <span class="text-(length:--fs-kind) tracking-[0.12em] text-primary-600">
                        {project.kind}
                      </span>
                    </div>
                    <p
                      class:list={[
                        "mt-1 text-(length:--fs-item) leading-relaxed",
                        isPlaceholder(project.summary)
                          ? "ph"
                          : "text-secondary-700",
                      ]}
                    >
                      {project.summary}
                    </p>
                    <p
                      class:list={[
                        "mt-2 text-(length:--fs-detail) leading-relaxed",
                        isPlaceholder(project.detail) ? "ph" : "text-secondary-500",
                      ]}
                    >
                      {project.detail}
                    </p>
                    {project.url && (
                      <p class="mt-2">
                        <a
                          href={project.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 rounded-md border border-primary-200 px-2 py-0.5 text-(length:--fs-tag) text-primary-700 transition-colors duration-200 hover:border-primary-300 hover:bg-primary-50 hover:text-primary-800 print:rounded-none print:border-0 print:px-0 print:py-0"
                        >
                          <span class="print:hidden">了解更多</span>
                          <Icon name="ri:arrow-right-up-line" class="size-[1.1em] print:hidden" />
                          <!-- 纸上点不了，所以打印时把按钮换成可以照着敲的地址 -->
                          <span class="hidden print:inline">{printableUrl(project.url)}</span>
                        </a>
                      </p>
                    )}
                  </article>
                ))}
            </div>
          </section>

          <div class="flex flex-col gap-6 sheet:grid sheet:grid-cols-[1fr_1fr] sheet:gap-6">
            <section>
              <SectionHeading title="技术方向" />
              <div class="mt-4 space-y-2.5 sheet:space-y-5">
                {stack.map((group) => (
                    <div>
                      <p class="text-(length:--fs-label) tracking-[0.16em] text-secondary-400">
                        {group.group}
                      </p>
                      <ul class="mt-1.5 flex flex-wrap gap-1.5 sheet:gap-1">
                        {group.items.map((item) => (
                          <li class="rounded-md border border-primary-200 bg-primary-50/70 px-2 py-0.5 text-(length:--fs-tag) text-secondary-800">
                            {item}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
              </div>
            </section>

            <section>
              <SectionHeading title="你可能想要知道的……" />
              <ul class="mt-4 space-y-2 sheet:space-y-3">
                {notes.map((note) => (
                    <li class="flex gap-2.5 text-(length:--fs-item) leading-snug text-secondary-700">
                      <span class="mt-[0.5em] size-1.5 shrink-0 rounded-full bg-primary-300" aria-hidden="true" />
                      <span>{note}</span>
                    </li>
                  ))}
              </ul>
            </section>
          </div>
        </main>

        <!-- 侧栏 · 下半：联系方式与网络身份 -->
        <aside
          class="border-t border-secondary-200 px-5 py-6 sheet:col-start-1 sheet:row-start-2 sheet:flex sheet:flex-col sheet:border-t-0 sheet:border-r sheet:border-secondary-200 sheet:px-6 sheet:pt-(--gap-side) sheet:pb-(--pad-y)"
        >
          <div
            class="space-y-5 sheet:flex sheet:h-full sheet:flex-col sheet:justify-start sheet:gap-(--gap-side) sheet:space-y-0"
          >
            <div>
              <SectionHeading title="联系方式" />
              <dl class="mt-2.5 space-y-2">
                {contacts.map((row) => (
                    <div class="flex items-center gap-2.5">
                      <dt class="shrink-0 text-(length:--fs-side) text-secondary-400">
                        <Icon name={row.icon} class="size-[1.15em]" />
                        <span class="sr-only">{row.label}</span>
                      </dt>
                      <dd
                        class:list={[
                          "text-(length:--fs-side) leading-snug",
                          isPlaceholder(row.value) ? "ph" : "text-secondary-700",
                        ]}
                      >
                        {row.value}
                      </dd>
                    </div>
                  ))}
              </dl>
            </div>

            <div>
              <SectionHeading title="互联网身份" />
              <dl class="mt-2.5 space-y-2">
                {identities.map((row) => (
                    <div class="flex items-center gap-2.5">
                      <dt class="shrink-0 text-(length:--fs-side) text-secondary-400">
                        <Icon name={row.icon} class="size-[1.15em]" />
                        <span class="sr-only">{row.label}</span>
                      </dt>
                      <dd class="text-(length:--fs-side) leading-snug">
                        <a
                          href={row.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-primary-800 underline decoration-primary-300 underline-offset-2 transition-colors hover:text-primary-600 hover:decoration-primary-500"
                        >
                          {row.value}
                        </a>
                      </dd>
                    </div>
                  ))}
              </dl>
            </div>
          </div>
        </aside>
      </div>

      <!-- 页脚 -->
      <footer
        class="flex items-center justify-between gap-4 border-t border-secondary-200 px-5 py-4 text-(length:--fs-micro) text-secondary-400 sheet:px-6 sheet:py-2.5"
      >
        <p class="tracking-[0.14em]">&copy; {new Date().getFullYear()} tcdw | Updated {profile.updatedAt}</p>
        <!--        <div class="flex items-center gap-4">
          <button
            type="button"
            onclick="window.print()"
            class="cursor-pointer rounded-xs border border-secondary-200 px-2 py-0.5 tracking-[0.14em] text-secondary-500 transition-colors hover:border-primary-300 hover:text-primary-700 print:hidden"
          >
            打印 / PDF
          </button>
        </div>-->
      </footer>
    </div>
  </body>
</html>
